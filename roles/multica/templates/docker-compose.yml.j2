---
# {{ ansible_managed }}

name: "{{ multica_role_name }}"

services:
  db:
    image: "{{ multica_postgres_image }}:{{ multica_postgres_image_tag }}"
    container_name: "{{ multica_role_name }}-db"
    restart: always
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_DB: "{{ multica_postgres_db }}"
      POSTGRES_USER: "{{ multica_postgres_user }}"
      POSTGRES_PASSWORD: "{{ multica_postgres_password }}"
    volumes:
      - ./db_data:/var/lib/postgresql/data
    networks:
      - "{{ multica_role_name }}_internal"
    labels:
      - "kopia.backup.target=true"
    deploy:
      resources:
        limits:
          cpus: "{{ multica_postgres_cpu_limit }}"
          memory: "{{ multica_postgres_mem_limit }}"
        reservations:
          cpus: "0.2"
          memory: "128M"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ multica_postgres_user }} -d {{ multica_postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    image: "{{ multica_backend_image }}:{{ multica_backend_image_tag }}"
    container_name: "{{ multica_role_name }}-backend"
    restart: always
    security_opt:
      - no-new-privileges:true
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - .env
    ports:
      - "127.0.0.1:{{ multica_backend_local_port }}:8080"
    volumes:
      - ./uploads:/app/data/uploads
    networks:
      - "{{ multica_role_name }}_internal"
      - "{{ multica_reverse_proxy_network }}"
    deploy:
      resources:
        limits:
          cpus: "{{ multica_backend_cpu_limit }}"
          memory: "{{ multica_backend_mem_limit }}"
        reservations:
          cpus: "0.2"
          memory: "128M"
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ multica_reverse_proxy_network }}"
      - "traefik.http.routers.{{ multica_role_name }}-api.rule=Host(`{{ multica_web_url }}`) && (PathPrefix(`/api`) || PathPrefix(`/auth`) || PathPrefix(`/ws`) || PathPrefix(`/uploads`))"
      - "traefik.http.routers.{{ multica_role_name }}-api.entrypoints=websecure"
      - "traefik.http.routers.{{ multica_role_name }}-api.tls=true"
      - "traefik.http.routers.{{ multica_role_name }}-api.tls.certresolver=letsencrypt-dns"
      - "traefik.http.routers.{{ multica_role_name }}-api.middlewares={{ multica_traefik_middlewares }}"
      - "traefik.http.services.{{ multica_role_name }}-api.loadbalancer.server.port=8080"

  frontend:
    image: "{{ multica_web_image }}:{{ multica_web_image_tag }}"
    container_name: "{{ multica_role_name }}-web"
    restart: always
    security_opt:
      - no-new-privileges:true
    depends_on:
      - backend
    environment:
      PORT: "3000"
      HOSTNAME: "0.0.0.0"
      BACKEND_URL: "http://backend:8080"
    networks:
      - "{{ multica_role_name }}_internal"
      - "{{ multica_reverse_proxy_network }}"
    deploy:
      resources:
        limits:
          cpus: "{{ multica_web_cpu_limit }}"
          memory: "{{ multica_web_mem_limit }}"
        reservations:
          cpus: "0.2"
          memory: "128M"
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ multica_reverse_proxy_network }}"
      - "traefik.http.routers.{{ multica_role_name }}-web.rule=Host(`{{ multica_web_url }}`)"
      - "traefik.http.routers.{{ multica_role_name }}-web.entrypoints=websecure"
      - "traefik.http.routers.{{ multica_role_name }}-web.tls=true"
      - "traefik.http.routers.{{ multica_role_name }}-web.tls.certresolver=letsencrypt-dns"
      - "traefik.http.routers.{{ multica_role_name }}-web.middlewares={{ multica_traefik_middlewares }}"
      - "traefik.http.services.{{ multica_role_name }}-web.loadbalancer.server.port=3000"

networks:
  "{{ multica_reverse_proxy_network }}":
    external: true
  "{{ multica_role_name }}_internal":
    name: "{{ multica_role_name }}_internal"
