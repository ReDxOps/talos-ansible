# {{ ansible_managed }}

# --- Database ---
POSTGRES_DB={{ multica_postgres_db }}
POSTGRES_USER={{ multica_postgres_user }}
POSTGRES_PASSWORD={{ multica_postgres_password }}
DATABASE_URL=postgres://{{ multica_postgres_user }}:{{ multica_postgres_password }}@{{ multica_role_name }}-db:5432/{{ multica_postgres_db }}?sslmode=disable

# --- Core & Security ---
JWT_SECRET={{ multica_jwt_secret }}
PORT=8080
FRONTEND_ORIGIN=https://{{ multica_web_url }}
CORS_ALLOWED_ORIGINS=https://{{ multica_web_url }}
APP_ENV={{ multica_app_env }}
DO_NOT_TRACK={{ 'true' if multica_do_not_track else 'false' }}
ALLOW_SIGNUP={{ 'true' if multica_allow_signup else 'false' }}
DISABLE_WORKSPACE_CREATION={{ 'true' if multica_disable_workspace_creation else 'false' }}
LOG_LEVEL={{ multica_log_level }}

# --- Storage ---
LOCAL_UPLOAD_DIR=/app/data/uploads
LOCAL_UPLOAD_BASE_URL=https://{{ multica_web_url }}

# --- Mail / SMTP ---
{% if multica_smtp_host | length > 0 %}
SMTP_HOST={{ multica_smtp_host }}
SMTP_PORT={{ multica_smtp_port }}
SMTP_USERNAME={{ multica_smtp_username }}
SMTP_PASSWORD={{ multica_smtp_password }}
SMTP_FROM_EMAIL={{ multica_smtp_from }}
{% endif %}

# --- Integrations & Channels ---
{% if multica_telegram_secret_key | length > 0 %}
MULTICA_TELEGRAM_SECRET_KEY={{ multica_telegram_secret_key }}
{% endif %}
