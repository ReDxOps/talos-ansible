##############################################################
{% set app_name = vaultwarden_app_name -%}{{ (" " ~ app_name ~ " .env FILE ").center(62, '#') }}
##############################################################

# General
DOMAIN={{ vaultwarden_domain }}
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | lower }}
SIGNUPS_VERIFY={{ vaultwarden_signups_verify | lower }}
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | lower }}

# Admin
{% if vaultwarden_admin_token %}
ADMIN_TOKEN='{{ vaultwarden_admin_token }}'
{% endif %}

# Database
DATABASE_URL={{ vaultwarden_db_url }}

# WebSockets / Push
WEBSOCKET_ENABLED={{ vaultwarden_websocket_enabled | lower }}
{% if vaultwarden_push_enabled %}
PUSH_ENABLED=true
PUSH_INSTALLATION_ID={{ vaultwarden_push_installation_id }}
PUSH_INSTALLATION_KEY={{ vaultwarden_push_installation_key }}
{% endif %}

# SMTP
{% if vaultwarden_smtp_enabled %}
SMTP_HOST={{ vaultwarden_smtp_host }}
SMTP_FROM={{ vaultwarden_smtp_from }}
SMTP_FROM_NAME={{ vaultwarden_smtp_from_name }}
SMTP_SECURITY={{ vaultwarden_smtp_security }}
SMTP_PORT={{ vaultwarden_smtp_port }}
SMTP_USERNAME={{ vaultwarden_smtp_username }}
SMTP_PASSWORD={{ vaultwarden_smtp_password }}
{% endif %}

# Logging
LOG_LEVEL={{ vaultwarden_log_level }}
EXTENDED_LOGGING=true

# Rocket
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT={{ vaultwarden_server_port }}

# vim: syntax=ini