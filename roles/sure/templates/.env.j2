##############################################################
{% set app_name = sure_app_name -%}{{ (" " ~ app_name ~ " .env FILE ").center(62, '#') }}
##############################################################

# Configuration cœur Rails / Self-Hosting
SECRET_KEY_BASE='{{ sure_secret_key_base }}'
{% if sure_ar_primary_key and sure_ar_deterministic_key and sure_ar_key_derivation_salt %}
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY='{{ sure_ar_primary_key }}'
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY='{{ sure_ar_deterministic_key }}'
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT='{{ sure_ar_key_derivation_salt }}'
{% endif %}
SELF_HOSTED=true
ONBOARDING_STATE={{ sure_onboarding_state }}
RAILS_ENV=production
RAILS_LOG_LEVEL={{ sure_log_level }}
PORT={{ sure_server_port }}
APP_DOMAIN={{ sure_web_url }}

# Terminaison TLS gérée en amont par Traefik
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=true

# Base de données PostgreSQL
DB_HOST={{ sure_app_name }}-db
DB_PORT=5432
POSTGRES_DB={{ sure_db_name }}
POSTGRES_USER={{ sure_db_user }}
POSTGRES_PASSWORD='{{ sure_db_password }}'

# Cache et file de tâches Redis (authentifié)
REDIS_PASSWORD='{{ sure_redis_password }}'
REDISCLI_AUTH='{{ sure_redis_password }}'
REDIS_URL=redis://:{{ sure_redis_password | urlencode }}@{{ sure_app_name }}-redis:6379/1

# Cours boursiers / ETF et taux de change
EXCHANGE_RATE_PROVIDER={{ sure_exchange_rate_provider }}
SECURITIES_PROVIDER={{ sure_securities_provider }}
{% if sure_twelve_data_api_key %}
TWELVE_DATA_API_KEY='{{ sure_twelve_data_api_key }}'
{% endif %}

# Envoi d'emails (exécuté par sure-worker)
{% if sure_smtp_enabled %}
SMTP_ADDRESS={{ sure_smtp_host }}
SMTP_PORT={{ sure_smtp_port }}
SMTP_USERNAME={{ sure_smtp_username }}
SMTP_PASSWORD='{{ sure_smtp_password }}'
SMTP_TLS_ENABLED={{ sure_smtp_tls_enabled | lower }}
SMTP_TLS_SKIP_VERIFY=false
EMAIL_SENDER={{ sure_email_sender }}
{% endif %}
